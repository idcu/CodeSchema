# CodeSchema Dockerfile
# 多阶段构建：build → runtime
#
# 构建镜像（默认启用 ONNX 语义检索；依赖已随 go mod vendor 固化进 vendor/，全程离线）：
#   docker build -t codeschema:latest .
#
# 运行容器（HTTP API）：
#   docker run --rm -p 8081:8081 -v codeschema-data:/app/data codeschema:latest
#
# 运行容器（MCP Server）：
#   docker run --rm -p 8080:8080 -v codeschema-data:/app/data codeschema:latest mcp --addr :8080
#
# 运行容器（扫描指定目录）：
#   docker run --rm -v /host/path:/repo codeschema:latest scan /repo
#
# ONNX 语义检索：默认 -tags onnx 构建（CGO + onnxruntime 动态库，模型与运行时随 down/ 分发）。
# 纯 Go 免 CGO 构建可传 --build-arg CGO_ENABLED=0（语义检索降级 LocalEmbedder，
# 结构化 / FTS / 影响面分析不受影响）；此时不需要 down/onnxruntime 的 .so。
#
# 依赖解析策略：本镜像使用 `go mod vendor`（vendor/ 由仓库/构建上下文提供），而非从
# gitee.com/idcu-go/* 拉取发布版。原因：code-schema 的 go.mod 通过本地 replace 指向
# ../idcu-go/*（开发期直接编本地代码），其中 recovery / trace 等模块并未发布到 gitee，
# 去掉 replace 后无法解析；vendor 把全部本地 replace 固化进镜像，构建离线且代码与本地一致。
#
# 基础镜像必须基于 glibc（Debian bookworm），不能用 alpine/musl：onnxruntime 预编译的
# libonnxruntime.so 依赖 libstdc++.so.6 / libgomp 等 glibc 运行时，musl 无法加载该 .so，
# 会导致 ONNX 静默降级为 LocalEmbedder（日志出现 `ONNX embedder not loaded ... → using
# LocalEmbedder`）。本镜像构建期（golang:1.25-bookworm）与运行期（debian:bookworm-slim）
# 均用 glibc，CGO 链接的二进制与 onnxruntime .so 同为 glibc ABI，ONNX 原生生效。
# 运行期已安装 libstdc++6 / libgomp1 满足 onnxruntime CPU 推理依赖。
#
# 国内网络若拉取 docker.io 基础镜像过慢，可用 Dockerfile.mirror（已预置 daocloud 国内源）
# 构建：docker build -f Dockerfile.mirror -t codeschema:onnx .

# === 构建阶段 ===
FROM docker.m.daocloud.io/library/golang:1.25-bookworm AS builder

# 默认启用 ONNX 语义检索（CGO + onnxruntime 动态库）；纯 Go 免 CGO 可传 --build-arg CGO_ENABLED=0。
ARG CGO_ENABLED=1
# Go 模块代理：国内网络默认走 goproxy.cn；其他环境可覆盖。
# 注意：本镜像使用 go mod vendor（vendor/ 随构建上下文提供），构建全程离线，
# 不依赖 gitee.com/idcu-go/* 的发布状态。
ARG GOPROXY=https://goproxy.cn,direct
# CGO 编译需要 gcc + glibc 头文件（Debian bookworm，glibc 基础，匹配 onnxruntime .so 的 ABI）。
RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc libc6-dev ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# 复制全部源码（含 vendor/ 与 down/）。vendor/ 由 `go mod vendor` 生成，已把 go.mod 中的
# 本地 replace（../idcu-go/*、down/chromem-go、third_party/onnxruntime_go_patch）全部固化，
# 因此构建无需访问 gitee 或上级目录，且与本地开发代码一致。
COPY . .

# onnxruntime 动态库 SONAME 带版本号（Linux libonnxruntime.so.1 / macOS libonnxruntime.1.23.2.dylib），
# 实际文件名无版本号；链接与运行时按 SONAME 解析，故建版本号软链（构建期与运行时共用）。
RUN ln -sf libonnxruntime.so /src/down/onnxruntime/libonnxruntime.so.1 \
 && ln -sf libonnxruntime.dylib /src/down/onnxruntime/libonnxruntime.1.23.2.dylib

ARG VERSION=dev
# ONNX 语义检索需链接 onnxruntime 动态库：-L 指向构建期库目录，-rpath 指向运行时库目录
# （/app/down/onnxruntime，由运行阶段 COPY down/ 提供），运行时无需系统 PATH/LD_LIBRARY_PATH。
ENV CGO_LDFLAGS="-L/src/down/onnxruntime -Wl,-rpath,/app/down/onnxruntime -lonnxruntime"
ENV GOTOOLCHAIN=local
RUN CGO_ENABLED=${CGO_ENABLED} go build -mod=vendor \
    -tags onnx \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /build/codeschema \
    ./cmd/codeschema

# === 运行阶段 ===
FROM docker.m.daocloud.io/library/debian:bookworm-slim

# 运行时需 glibc 系的 onnxruntime 依赖库：libstdc++.so.6（C++ 运行时）、
# libgomp（OpenMP，onnxruntime CPU 推理依赖）。ca-certificates / tzdata 供网络与时间。
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates tzdata libstdc++6 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/codeschema .
# ONNX 模型与 onnxruntime 动态库（构建期已建好版本号软链），供语义检索运行时加载。
COPY --from=builder /src/down /app/down

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/app/codeschema", "version"]

EXPOSE 8080 8081

ENTRYPOINT ["/app/codeschema"]
CMD ["serve", "--http", ":8081"]
