# =============================================================================
# CodeSchema 配置示例
# =============================================================================
# 使用方式：
#   1. 复制本文件为 config.yaml
#   2. 按需修改配置项
#   3. 启动服务：codeschema --config config.yaml serve
#
# 优先级：默认值 < 配置文件 < 环境变量(CODESCHEMA_*) < CLI 参数
# 所有配置项都有默认值，不配置也可直接运行。
# =============================================================================

# ---------------------------------------------------------------------------
# 项目配置
# ---------------------------------------------------------------------------
project:
  # 项目名称，用于标识和日志
  name: "my-project"
  # 仓库根路径（scan/watch 命令的默认路径）
  root: "/path/to/your/repo"
  # 目标语言列表（影响解析器选择）
  languages:
    - go
    - java
    - python
    - typescript
    - rust
    - cpp

# ---------------------------------------------------------------------------
# 存储配置
# ---------------------------------------------------------------------------
storage:
  # 存储驱动：file（JSON 文件，零依赖）
  driver: "file"
  # 数据存储目录（索引持久化路径）
  dsn: "./data"

  # 向量库配置
  vector:
    # 向量库驱动：chromem（嵌入式，零依赖）
    driver: "chromem"
    # 向量库路径
    dsn: "./vector.db"
    # Embedding 模型（当前仅用于标识）
    embedding_model: "bge-small-zh"

  # 搜索配置
  search:
    # 启用 FTS5 全文搜索
    fts: true
    # 启用语义检索（向量搜索）
    semantic: true
    # 全文搜索索引目录
    fts_dir: "./data/fts"
    # 向量索引目录
    vector_dir: "./data/vector"
    # 向量维度（128-1024，越大越精确但更耗内存）
    vector_dim: 1024
    # IDF 词典目录
    idf_dir: "./data/idf"

# ---------------------------------------------------------------------------
# 解析器配置
# ---------------------------------------------------------------------------
parser:
  # 启用的解析适配器列表
  adapters:
    - treesitter
  # SCIP index 适配器配置
  scip:
    index_dir: "./scipout"
  # CodeGraph 适配器配置
  codegraph:
    db: "./codegraph.db"
  # JCodeIndexer 适配器配置
  jcodeindexer:
    db: "./jcodeindexer.db"
    config_file: ".jindexer/config.yaml"
    env:
      INDEXER_EMBEDDING_ENABLED: "false"

# ---------------------------------------------------------------------------
# AI 增强配置
# ---------------------------------------------------------------------------
ai:
  # AI 提供商：openai | anthropic | local
  provider: "openai"
  # 模型名
  model: "gpt-4o-mini"
  # 每次扫描 AI 调用硬限
  budget_per_scan: 100
  # 每次查询 AI 调用硬限
  budget_per_query: 10

# ---------------------------------------------------------------------------
# 服务器配置
# ---------------------------------------------------------------------------
server:
  # MCP Server 监听地址（供 AI 工具连接）
  mcp_addr: ":8080"
  # HTTP API 监听地址（供浏览器/REST 调用）
  http_addr: ":8081"
  # Bearer token 认证（空字符串 = 不启用认证）
  auth_token: ""

# ---------------------------------------------------------------------------
# 文件监听配置
# ---------------------------------------------------------------------------
watcher:
  # 是否启用文件监听
  enabled: true
  # 防抖窗口（毫秒），文件变更后等待多久再处理
  debounce_ms: 300
  # 忽略的目录（不监听）
  ignore_dirs:
    - ".git"
    - "node_modules"
    - "target"
    - "build"
    - "vendor"
    - "dist"
    - ".next"
  # 单批处理的最大文件数
  batch_size: 50
  # 是否使用 fsnotify 原生监听（默认 false 使用轮询）
  use_fsnotify: false

# ---------------------------------------------------------------------------
# 扫描器配置
# ---------------------------------------------------------------------------
scanner:
  # 并发解析 worker 数
  workers: 4
  # 超过此大小（MB）的文件跳过解析
  file_size_limit_mb: 10
  # 超过此行数的文件跳过解析
  line_count_limit: 50000