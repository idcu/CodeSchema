# =============================================================================
# CodeSchema 配置示例
# =============================================================================
# 使用方式：
#   1. 复制本文件为 config.yaml
#   2. 按需修改配置项
#   3. 启动服务：codeschema --config config.yaml serve
#
# 优先级：默认值 < 配置文件 < 环境变量(CODESCHEMA_*) < CLI 参数
# 所有配置项都有默认值，不配置也可直接运行。
# =============================================================================

# ---------------------------------------------------------------------------
# 能力层预设（可选）：minimal / semantic / multitenant / ""（默认）
# 用单个字段组合整组能力配置，无需逐项手写；预设是其管理字段的权威来源。
#   minimal     最小资源档：仅 FTS 检索，关语义/向量/ONNX，关 AI 增强
#   semantic    语义档：FTS + 语义检索（向量/ONNX），保持 AI 增强
#   multitenant 多租户档：保持全能力，增量监听默认开启
# ---------------------------------------------------------------------------
# preset: ""

# ---------------------------------------------------------------------------
# 项目配置
# ---------------------------------------------------------------------------
project:
  # 项目名称，用于标识和日志
  name: "my-project"
  # 仓库根路径（scan/watch 命令的默认路径）
  root: "/path/to/your/repo"
  # 目标语言列表（影响解析器选择）
  languages:
    - go
    - java
    - python
    - typescript
    - rust
    - cpp

# ---------------------------------------------------------------------------
# 存储配置
# ---------------------------------------------------------------------------
storage:
  # 存储驱动：file（JSON 文件，零依赖，默认）| sqlite（modernc 纯 Go）| pg（需 -tags pg）| redis（热点缓存，需 -tags redis）
  driver: "file"
  # 数据存储目录（索引持久化路径）
  dsn: "./data"
  # KV 层（Redis L2 缓存/反查，需 -tags redis 构建才生效；空则不启用）
  kv: ""

  # 向量配置
  # 注：向量后端当前由代码固定为 PersistentStore（JSON 落盘）+ MemoryStore 语义检索，
  # driver 字段仅作配置占位（chromem 实现存在但未接线生产路径）。
  vector:
    # 向量库驱动（占位：chromem 为可选实现，未接入生产分发）
    driver: "chromem"
    # 向量库路径
    dsn: "./vector.db"
    # Embedding 模型（用于模型目录与远程分发占位；制品为 bge-small-zh-v1.5）
    embedding_model: "bge-small-zh-v1.5"
    # 模型目录（含 onnx/ 子目录 + tokenizer.json）；默认 down/models/<embedding_model>
    model_dir: "./down/models/bge-small-zh-v1.5"
    # ONNX 模型远程分发（可选）：模型缺失时自动下载并解包（幂等）。
    # 支持 {model} 占位符替换 embedding_model。
    model_download_url: ""
    # 模型压缩包 SHA-256 校验和（可选，配置后下载即校验，不匹配拒绝解包）
    model_sha256: ""

  # 搜索配置
  search:
    # 启用全文搜索（纯 Go PersistentFTS 实现，非 SQLite FTS5）
    fts: true
    # 启用语义检索（向量搜索）
    semantic: true
    # 全文搜索索引目录
    fts_dir: "./data/fts"
    # 向量索引目录
    vector_dir: "./data/vector"
    # 向量维度（128-1024，越大越精确但更耗内存）
    vector_dim: 1024
    # IDF 词典目录
    idf_dir: "./data/idf"

# ---------------------------------------------------------------------------
# 解析器配置
# ---------------------------------------------------------------------------
parser:
  # 启用的解析适配器列表
  adapters:
    - treesitter
  # SCIP index 适配器配置
  scip:
    index_dir: "./scipout"
  # CodeGraph 适配器配置
  codegraph:
    db: "./codegraph.db"
  # JCodeIndexer 适配器配置
  jcodeindexer:
    db: "./jcodeindexer.db"
    config_file: ".jindexer/config.yaml"
    env:
      INDEXER_EMBEDDING_ENABLED: "false"
  # LSP 适配器配置（接入解析编排主路，按语言分发 gopls/jdtls/clangd）
  # 启用后：工具存在则优先 LSP 解析（精度更高），缺失/失败自动回退 tree-sitter。
  lsp:
    enabled: false

# ---------------------------------------------------------------------------
# AI 增强配置
# ---------------------------------------------------------------------------
ai:
  # OpenAI 兼容客户端（BaseURL 可指向任意 OpenAI 兼容端点，含 openai/anthropic 网关/本地 vLLM 等）。
  # 缺 base_url / api_key / model 任一即禁用 AI 增强（规则标签与索引不受影响）。
  provider: "openai"
  # API 根地址（如 https://api.openai.com/v1）；空则禁用 AI
  base_url: "https://api.openai.com/v1"
  # 鉴权密钥；空则禁用 AI
  api_key: ""
  # 模型名
  model: "gpt-4o-mini"
  # 每次扫描 AI 调用硬限
  budget_per_scan: 100
  # 每次查询 AI 调用硬限
  budget_per_query: 10

# ---------------------------------------------------------------------------
# 服务器配置
# ---------------------------------------------------------------------------
server:
  # MCP Server 监听地址（供 AI 工具连接）。生产收敛：改为 127.0.0.1:<port>
  # 或经 Nginx 内网反代（示例见 build/secure-demo.yaml）。
  mcp_addr: ":8080"
  # HTTP API 监听地址（供浏览器/REST 调用）。同上生产收敛建议。
  http_addr: ":8081"
  # Bearer token 认证（空字符串 = 不启用认证；生产必须设置）
  auth_token: ""
  # 全局限流：每分钟请求上限（令牌桶，突发=上限）。0 = 不限流（默认）
  rate_limit: 0

# ---------------------------------------------------------------------------
# 文件监听配置
# ---------------------------------------------------------------------------
watcher:
  # 是否启用文件监听
  enabled: true
  # 防抖窗口（毫秒），文件变更后等待多久再处理
  debounce_ms: 300
  # 忽略的目录（不监听）
  ignore_dirs:
    - ".git"
    - "node_modules"
    - "target"
    - "build"
    - "vendor"
    - "dist"
    - ".next"
  # 单批处理的最大文件数
  batch_size: 50
  # 是否使用 fsnotify 原生监听（默认 false 使用轮询）
  use_fsnotify: false

# ---------------------------------------------------------------------------
# 扫描器配置
# ---------------------------------------------------------------------------
scanner:
  # 并发解析 worker 数
  workers: 4
  # 超过此大小（MB）的文件跳过解析
  file_size_limit_mb: 10
  # 超过此行数的文件跳过解析
  line_count_limit: 50000

# ---------------------------------------------------------------------------
# 上下文供给配置（裁剪 / 预算 / 路径形态 / 查询缓存）
# ---------------------------------------------------------------------------
# 说明：这里是「服务端默认值」。请求显式传参时以请求为准，未传时才取这里的默认值。
context:
  # 默认外扩上下文行数；0 = 只给符号体本身（调用方可用 context_lines 覆盖）
  context_lines: 0
  # 默认输出字节预算；0 = 不限。与 max_tokens 是「与」关系，取更严者
  max_bytes: 0
  # 默认输出 token 预算；0 = 不限
  max_tokens: 0
  # 默认单行字符上限；0 = 不截断（建议大仓设 250~500，防压缩产物一行吃掉预算）
  max_line_chars: 0
  # token 估算口径（每 token 折合字节数）；0 = 用默认 4（中文为主的内容可设 1.5~2）
  chars_per_token: 0
  # 默认路径输出形态：absolute = 宿主真实路径；virtual = 项目根映射为 /codebase
  default_path_style: absolute
  # 查询级缓存：相同「符号 + 裁剪参数」在 TTL 内直接命中（索引变更时自动失效）
  query_cache:
    # 默认关闭：只有 Agent 高频重复查询的场景才划算
    enabled: false
    # 存活毫秒；0 = 30s
    ttl_ms: 0
    # 最多缓存条目数；0 = 512
    max_entries: 0

# ---------------------------------------------------------------------------
# 多租户配置（可选）
# ---------------------------------------------------------------------------
# 多租户（单实例多仓库，可选）：一个进程服务多个隔离仓库，按 project 路由
# tenants:
#   - id: demo-a
#     name: "Demo A"
#     root: ./cmd                  # 要扫描的仓库根目录
#     storage:
#       dsn: ./build/mt-a          # 该租户独立存储目录（索引按此派生隔离）
#     auto_scan: true              # 启动时自动扫描
#     watch: false                 # 是否监听增量
#   - id: demo-b
#     name: "Demo B"
#     root: ./internal/config
#     storage:
#       dsn: ./build/mt-b
#     auto_scan: true
#     watch: false
# 不配置 tenants 时退化为单 "default" 租户，行为与原单项目模式完全一致。