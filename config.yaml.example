# =============================================================================
# CodeSchema 配置示例
# =============================================================================
# 使用方式：
#   1. 复制本文件为 config.yaml
#   2. 按需修改配置项
#   3. 启动服务：codeschema --config config.yaml serve
#
# 优先级：默认值 < 配置文件 < 环境变量(CODESCHEMA_*) < CLI 参数
# 所有配置项都有默认值，不配置也可直接运行。
# =============================================================================

# ---------------------------------------------------------------------------
# 项目配置
# ---------------------------------------------------------------------------
project:
  # 项目名称，用于标识和日志
  name: "my-project"
  # 仓库根路径（scan/watch 命令的默认路径）
  root: "/path/to/your/repo"
  # 目标语言列表（影响解析器选择）
  languages:
    - go
    - java
    - python
    - typescript
    - rust
    - cpp

# ---------------------------------------------------------------------------
# 存储配置
# ---------------------------------------------------------------------------
storage:
  # 存储驱动：file（JSON 文件，零依赖，默认）| sqlite（modernc 纯 Go）| pg（需 -tags pg）| redis（热点缓存，需 -tags redis）
  driver: "file"
  # 数据存储目录（索引持久化路径）
  dsn: "./data"
  # KV 层（Redis L2 缓存/反查，需 -tags redis 构建才生效；空则不启用）
  kv: ""

  # 向量配置
  # 注：向量后端当前由代码固定为 PersistentStore（JSON 落盘）+ MemoryStore 语义检索，
  # driver 字段仅作配置占位（chromem 实现存在但未接线生产路径）。
  vector:
    # 向量库驱动（占位：chromem 为可选实现，未接入生产分发）
    driver: "chromem"
    # 向量库路径
    dsn: "./vector.db"
    # Embedding 模型（用于模型目录与远程分发占位；制品为 bge-small-zh-v1.5）
    embedding_model: "bge-small-zh-v1.5"
    # 模型目录（含 onnx/ 子目录 + tokenizer.json）；默认 down/models/<embedding_model>
    model_dir: "./down/models/bge-small-zh-v1.5"
    # ONNX 模型远程分发（可选）：模型缺失时自动下载并解包（幂等）。
    # 支持 {model} 占位符替换 embedding_model。
    model_download_url: ""
    # 模型压缩包 SHA-256 校验和（可选，配置后下载即校验，不匹配拒绝解包）
    model_sha256: ""

  # 搜索配置
  search:
    # 启用全文搜索（纯 Go PersistentFTS 实现，非 SQLite FTS5）
    fts: true
    # 启用语义检索（向量搜索）
    semantic: true
    # 全文搜索索引目录
    fts_dir: "./data/fts"
    # 向量索引目录
    vector_dir: "./data/vector"
    # 向量维度（128-1024，越大越精确但更耗内存）
    vector_dim: 1024
    # IDF 词典目录
    idf_dir: "./data/idf"

# ---------------------------------------------------------------------------
# 解析器配置
# ---------------------------------------------------------------------------
parser:
  # 启用的解析适配器列表
  adapters:
    - treesitter
  # SCIP index 适配器配置
  scip:
    index_dir: "./scipout"
  # CodeGraph 适配器配置
  codegraph:
    db: "./codegraph.db"
  # JCodeIndexer 适配器配置
  jcodeindexer:
    db: "./jcodeindexer.db"
    config_file: ".jindexer/config.yaml"
    env:
      INDEXER_EMBEDDING_ENABLED: "false"
  # LSP 适配器配置（接入解析编排主路，按语言分发 gopls/jdtls/clangd）
  # 启用后：工具存在则优先 LSP 解析（精度更高），缺失/失败自动回退 tree-sitter。
  lsp:
    enabled: false

# ---------------------------------------------------------------------------
# AI 增强配置
# ---------------------------------------------------------------------------
ai:
  # OpenAI 兼容客户端（BaseURL 可指向任意 OpenAI 兼容端点，含 openai/anthropic 网关/本地 vLLM 等）。
  # 缺 base_url / api_key / model 任一即禁用 AI 增强（规则标签与索引不受影响）。
  provider: "openai"
  # API 根地址（如 https://api.openai.com/v1）；空则禁用 AI
  base_url: "https://api.openai.com/v1"
  # 鉴权密钥；空则禁用 AI
  api_key: ""
  # 模型名
  model: "gpt-4o-mini"
  # 每次扫描 AI 调用硬限
  budget_per_scan: 100
  # 每次查询 AI 调用硬限
  budget_per_query: 10

# ---------------------------------------------------------------------------
# 服务器配置
# ---------------------------------------------------------------------------
server:
  # MCP Server 监听地址（供 AI 工具连接）
  mcp_addr: ":8080"
  # HTTP API 监听地址（供浏览器/REST 调用）
  http_addr: ":8081"
  # Bearer token 认证（空字符串 = 不启用认证）
  auth_token: ""

# ---------------------------------------------------------------------------
# 文件监听配置
# ---------------------------------------------------------------------------
watcher:
  # 是否启用文件监听
  enabled: true
  # 防抖窗口（毫秒），文件变更后等待多久再处理
  debounce_ms: 300
  # 忽略的目录（不监听）
  ignore_dirs:
    - ".git"
    - "node_modules"
    - "target"
    - "build"
    - "vendor"
    - "dist"
    - ".next"
  # 单批处理的最大文件数
  batch_size: 50
  # 是否使用 fsnotify 原生监听（默认 false 使用轮询）
  use_fsnotify: false

# ---------------------------------------------------------------------------
# 扫描器配置
# ---------------------------------------------------------------------------
scanner:
  # 并发解析 worker 数
  workers: 4
  # 超过此大小（MB）的文件跳过解析
  file_size_limit_mb: 10
  # 超过此行数的文件跳过解析
  line_count_limit: 50000